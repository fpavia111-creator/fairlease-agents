    "./package.json": "./package.json"
  },
  "bin": {
    "fairlease-acquisition-diligence": "bin/fairlease-acquisition-diligence.js"
  },
  "files": [
    "src",
    "bin",
    "fixtures",
    "evals",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "server.json"
  ],
  "scripts": {
    "test": "node scripts/run-tests.cjs",
    "demo": "node bin/fairlease-acquisition-diligence.js demo",
