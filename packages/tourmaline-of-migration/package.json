{
  "name": "tourmaline-of-migration",
  "version": "0.1.0",
  "mcpName": "io.github.fpavia111-creator/tourmaline-of-migration",
  "description": "Tourmaline of Migration: checks a property management system migration by comparing the old system's rent roll with the new one's at cutover: units missing or added, tenants, rents, deposits, balances, areas and lease dates that changed, and totals that do not tie; drafts a punch list for the implementation team. Go-live is a person's call.",
  "type": "module",
  "license": "MIT",
  "author": "Kurt Francisco",
  "engines": {
    "node": ">=20"
  },
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "tourmaline-of-migration": "bin/tourmaline-of-migration.js"
  },
  "files": [
    "src",
    "bin",
    "fixtures",
    "evals",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "server.json"
  ],
  "scripts": {
    "test": "node scripts/run-tests.cjs",
    "demo": "node bin/tourmaline-of-migration.js demo",
    "eval": "node bin/tourmaline-of-migration.js eval"
  },
  "dependencies": {
    "keystone-core": "^0.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fpavia111-creator/keystone-agents.git",
    "directory": "packages/tourmaline-of-migration"
  },
  "homepage": "https://github.com/fpavia111-creator/keystone-agents/tree/main/packages/tourmaline-of-migration#readme",
  "bugs": {
    "url": "https://github.com/fpavia111-creator/keystone-agents/issues"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "property-management",
    "real-estate",
    "keystone",
    "migration"
  ]
}
