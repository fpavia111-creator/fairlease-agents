{
  "name": "flint-of-inspections",
  "version": "0.1.0",
  "mcpName": "io.github.fpavia111-creator/flint-of-inspections",
  "description": "Flint of Inspections: compares move-out inspections with move-in item by item, flags units overdue for their periodic inspection and poor items with no work order, and drafts inspection notices.",
  "type": "module",
  "license": "MIT",
  "author": "Kurt Francisco",
  "engines": {
    "node": ">=20"
  },
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "flint-of-inspections": "bin/flint-of-inspections.js"
  },
  "files": [
    "src",
    "bin",
    "fixtures",
    "evals",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "server.json"
  ],
  "scripts": {
    "test": "node scripts/run-tests.cjs",
    "demo": "node bin/flint-of-inspections.js demo",
    "eval": "node bin/flint-of-inspections.js eval"
  },
  "dependencies": {
    "keystone-core": "^0.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fpavia111-creator/keystone-agents.git",
    "directory": "packages/flint-of-inspections"
  },
  "homepage": "https://github.com/fpavia111-creator/keystone-agents/tree/main/packages/flint-of-inspections#readme",
  "bugs": {
    "url": "https://github.com/fpavia111-creator/keystone-agents/issues"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "property-management",
    "real-estate",
    "keystone",
    "inspections"
  ]
}
