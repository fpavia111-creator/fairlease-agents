    "./package.json": "./package.json"
  },
  "bin": {
    "mica-of-leads": "bin/mica-of-leads.js"
  },
  "files": [
    "src",
    "bin",
    "fixtures",
    "evals",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
