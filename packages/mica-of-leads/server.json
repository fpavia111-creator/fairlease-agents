{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.fpavia111-creator/mica-of-leads",
  "title": "Mica of Leads",
  "description": "Mica of Leads: checks the leasing funnel from guest cards and lead exports: leads not answered or…",
  "version": "0.1.0",
  "repository": {
    "url": "https://github.com/fpavia111-creator/keystone-agents",
    "source": "github",
    "subfolder": "packages/mica-of-leads"
  },
  "websiteUrl": "https://fair-agents.com/fairlease.html",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "mica-of-leads",
      "version": "0.1.0",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        },
        {
          "type": "named",
          "name": "--root",
          "description": "Folder holding the exports this agent may read and write (it cannot reach outside it)",
          "isRequired": true,
          "format": "filepath",
          "valueHint": "exports_folder"
        }
      ]
    }
  ]
}
