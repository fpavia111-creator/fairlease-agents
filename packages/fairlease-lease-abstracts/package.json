{
  "name": "fairlease-lease-abstracts",
  "version": "0.1.0",
  "mcpName": "io.github.fpavia111-creator/fairlease-lease-abstracts",
  "description": "Fairlease Lease Abstracts: abstracts commercial lease text into the Fairlease leases format with a citation for every term, and checks existing abstracts against the lease text.",
