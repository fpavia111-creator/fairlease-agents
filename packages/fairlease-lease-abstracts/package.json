  "engines": {
    "node": ">=20"
  },
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "fairlease-lease-abstracts": "bin/fairlease-lease-abstracts.js"
  },
  "files": [
    "src",
    "bin",
    "fixtures",
    "evals",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "server.json"
  ],
  "scripts": {
    "test": "node scripts/run-tests.cjs",
    "demo": "node bin/fairlease-lease-abstracts.js demo",
    "eval": "node bin/fairlease-lease-abstracts.js eval"
  },
  "dependencies": {
    "fairlease-core": "^0.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fpavia111-creator/fairlease-agents.git",
    "directory": "packages/fairlease-lease-abstracts"
  },
  "homepage": "https://github.com/fpavia111-creator/fairlease-agents/tree/master/packages/fairlease-lease-abstracts#readme",
  "bugs": {
    "url": "https://github.com/fpavia111-creator/fairlease-agents/issues"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "property-management",
    "real-estate",
    "keystone",
    "lease-abstraction",
    "lease-abstract",
    "commercial-real-estate"
  ]
