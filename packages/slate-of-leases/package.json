{
  "name": "slate-of-leases",
  "version": "0.1.0",
  "mcpName": "io.github.fpavia111-creator/slate-of-leases",
  "description": "Slate of Leases: abstracts commercial lease text into the Keystone leases format with a citation for every term, and checks existing abstracts against the lease text.",
  "type": "module",
  "license": "MIT",
  "author": "Kurt Francisco",
  "engines": {
    "node": ">=20"
  },
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "slate-of-leases": "bin/slate-of-leases.js"
  },
  "files": [
    "src",
    "bin",
    "fixtures",
    "evals",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "server.json"
  ],
  "scripts": {
    "test": "node scripts/run-tests.cjs",
    "demo": "node bin/slate-of-leases.js demo",
    "eval": "node bin/slate-of-leases.js eval"
  },
  "dependencies": {
    "keystone-core": "^0.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fpavia111-creator/keystone-agents.git",
    "directory": "packages/slate-of-leases"
  },
  "homepage": "https://github.com/fpavia111-creator/keystone-agents/tree/main/packages/slate-of-leases#readme",
  "bugs": {
    "url": "https://github.com/fpavia111-creator/keystone-agents/issues"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "property-management",
    "real-estate",
    "keystone",
    "lease-abstraction",
    "lease-abstract",
    "commercial-real-estate"
  ]
}
