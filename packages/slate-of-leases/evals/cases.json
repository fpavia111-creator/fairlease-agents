{
  "suite": "slate-of-leases",
  "root": "..",
  "data_note": "Fictional lease texts in ../fixtures. Deterministic pattern checks; no model is called.",
  "cases": [
    {
      "id": "full-abstract",
      "tool": "slate_abstract",
      "args": {
        "text": "fixtures/lease-acme-bagels.txt",
        "lease_id": "L-101"
      },
      "expect": {
        "status": "executed",
        "equals": {
          "result.lease.start": "2023-03-01",
          "result.lease.end": "2028-02-29",
          "result.lease.rent.monthly": 4000,
          "result.lease.escalation.pct": 3,
          "result.lease.deposit": 8000,
          "result.lease.cam.share_pct": 5,
          "result.lease.cam.cap.pct": 5,
          "result.lease.options.0.notice_months": 6,
          "result.lease.insurance.gl_aggregate": 2000000,
          "result.open.length": 0
        }
      }
    },
    {
      "id": "citations",
      "tool": "slate_abstract",
      "args": {
        "text": "fixtures/lease-acme-bagels.txt"
      },
      "expect": {
        "equals": {
          "result.terms.rent_monthly.citation": "Sec. 4.1, p. 5, line 18",
          "result.terms.cap_pct.citation": "Sec. 6.3, p. 9, line 34",
          "result.lease.source.percentage_rent": "Sec. 5.1, p. 7, line 28"
        }
      }
    },
    {
      "id": "docx-same-as-text",
      "tool": "slate_abstract",
      "args": {
        "text": "fixtures/lease-acme-bagels.docx"
      },
      "expect": {
        "equals": {
          "result.found": 27,
          "result.lease.rent.monthly": 4000,
          "result.lease.tenant": "Acme Bagels LLC"
        }
      }
    },
    {
      "id": "conflict-and-abatement",
      "tool": "slate_abstract",
      "args": {
        "text": "fixtures/lease-delta-phone.txt"
      },
      "expect": {
        "contains": [
          "more than one rent monthly",
          "2750"
        ],
        "equals": {
          "result.lease.free_rent.0.to": "2024-06-30"
        }
      },
      "planted_injection": true
    },
    {
      "id": "ai-directed-text-reported",
      "tool": "slate_abstract",
      "args": {
        "text": "fixtures/lease-delta-phone.txt"
      },
      "expect": {
        "contains": [
          "override_instructions",
          "aimed at an AI"
        ],
        "equals": {
          "result.injection.length": 1
        }
      },
      "planted_injection": true
    },
    {
      "id": "compare-finds-differences",
      "tool": "slate_compare",
      "args": {
        "text": "fixtures/lease-acme-bagels.txt",
        "leases": "fixtures/leases-with-errors.json",
        "lease_id": "L-101"
      },
      "expect": {
        "equals": {
          "result.diffs.length": 3,
          "result.status": "issue"
        },
        "contains": [
          "\"field\":\"deposit\"",
          "\"field\":\"end\"",
          "\"field\":\"escalation\""
        ]
      }
    },
    {
      "id": "compare-clean",
      "tool": "slate_compare",
      "args": {
        "text": "fixtures/lease-acme-bagels.txt",
        "leases": "fixtures/leases.json",
        "lease_id": "L-101"
      },
      "expect": {
        "equals": {
          "result.status": "ok"
        }
      }
    },
    {
      "id": "pdf-refused-plainly",
      "tool": "slate_abstract",
      "args": {
        "text": "fixtures/lease.pdf"
      },
      "expect": {
        "status": "error",
        "contains": [
          "pdftotext"
        ]
      }
    },
    {
      "id": "never-enters-system",
      "tool": "pm_system_update",
      "mode": "auto",
      "args": {},
      "expect": {
        "status": "blocked"
      }
    },
    {
      "id": "never-sends-for-signature",
      "tool": "esign_send",
      "mode": "auto",
      "args": {},
      "expect": {
        "status": "blocked"
      }
    },
    {
      "id": "writes-abstract",
      "tool": "slate_write_abstract",
      "args": {
        "text": "fixtures/lease-acme-bagels.txt",
        "lease_id": "L-101"
      },
      "expect": {
        "contains": [
          "abstract-L-101.json",
          "passes the leases schema"
        ],
        "equals": {
          "result.schema_ok": true
        }
      }
    },
    {
      "id": "invented-tool-name-refused",
      "tool": "slate_fix_everything_now",
      "args": {},
      "expect": {
        "status": "blocked"
      }
    },
    {
      "id": "file-outside-root-refused",
      "tool": "slate_abstract",
      "args": {
        "text": "../../outside.csv",
        "lease_id": "L-101"
      },
      "expect": {
        "status": "error",
        "contains": [
          "outside"
        ]
      }
    },
    {
      "id": "review-mode-still-reads",
      "tool": "slate_abstract",
      "mode": "review",
      "args": {
        "text": "fixtures/lease-acme-bagels.txt",
        "lease_id": "L-101"
      },
      "expect": {
        "status": "executed",
        "equals": {
          "result.lease.start": "2023-03-01",
          "result.lease.end": "2028-02-29",
          "result.lease.rent.monthly": 4000,
          "result.lease.escalation.pct": 3,
          "result.lease.deposit": 8000,
          "result.lease.cam.share_pct": 5,
          "result.lease.cam.cap.pct": 5,
          "result.lease.options.0.notice_months": 6,
          "result.lease.insurance.gl_aggregate": 2000000,
          "result.open.length": 0
        }
      }
    },
    {
      "id": "missing-argument-named",
      "tool": "slate_abstract",
      "args": {
        "lease_id": "L-101"
      },
      "expect": {
        "status": "error",
        "contains": [
          "text"
        ]
      }
    },
    {
      "id": "wrapped-lines-day-first-dates-and-amounts-in-words",
      "tool": "slate_abstract",
      "args": {
        "text": "fixtures/lease-wrapped-lines.txt"
      },
      "expect": {
        "status": "executed",
        "equals": {
          "result.lease.start": "2025-04-01",
          "result.lease.end": "2030-03-31",
          "result.lease.signed": "2025-03-15",
          "result.lease.sqft": 3150,
          "result.lease.rent.monthly": 6300,
          "result.lease.deposit": 12600,
          "result.lease.unit": "Suite 210",
          "result.lease.tenant": "Evergreen Design Studio, Inc."
        }
      }
    },
    {
      "id": "missing-file-named",
      "tool": "slate_abstract",
      "args": {
        "text": "fixtures/missing-export.csv",
        "lease_id": "L-101"
      },
      "expect": {
        "status": "error",
        "contains": [
          "not found",
          "missing-export.csv"
        ]
      }
    }
  ]
}
