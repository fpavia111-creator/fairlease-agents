{
  "name": "pyrite-of-fees",
  "version": "0.1.0",
  "mcpName": "io.github.fpavia111-creator/pyrite-of-fees",
  "description": "Pyrite of Fees: recomputes the management, leasing, renewal and markup fees you charged each owner from the terms of their management agreement, and flags overcharges, undercharges, duplicates and fees the agreement does not provide for.",
  "type": "module",
  "license": "MIT",
  "author": "Kurt Francisco",
  "engines": {
    "node": ">=20"
  },
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "pyrite-of-fees": "bin/pyrite-of-fees.js"
  },
  "files": [
    "src",
    "bin",
    "fixtures",
    "evals",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "server.json"
  ],
  "scripts": {
    "test": "node scripts/run-tests.cjs",
    "demo": "node bin/pyrite-of-fees.js demo",
    "eval": "node bin/pyrite-of-fees.js eval"
  },
  "dependencies": {
    "keystone-core": "^0.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fpavia111-creator/keystone-agents.git",
    "directory": "packages/pyrite-of-fees"
  },
  "homepage": "https://github.com/fpavia111-creator/keystone-agents/tree/main/packages/pyrite-of-fees#readme",
  "bugs": {
    "url": "https://github.com/fpavia111-creator/keystone-agents/issues"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "property-management",
    "real-estate",
    "keystone",
    "fees"
  ]
}
