    "./package.json": "./package.json"
  },
  "bin": {
    "shale-of-vacancy": "bin/shale-of-vacancy.js"
  },
  "files": [
    "src",
    "bin",
    "fixtures",
    "evals",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "server.json"
  ],
  "scripts": {
