{
  "suite": "fairlease-budget-variance",
  "root": "..",
  "data_note": "Fictional 2026 budget, twelve-month actuals and a Japanese budget file in ../fixtures. Deterministic checks; no model is called.",
  "cases": [
    {
      "id": "totals",
      "tool": "budget_check",
      "args": {
        "budget": "fixtures/budget-2026.csv",
        "actuals": "fixtures/actuals-t12-2026-11.csv",
        "policy": "fixtures/budget-policy.json",
        "as_of": "2026-11-15"
      },
      "expect": {
        "status": "executed",
        "equals": {
          "result.month": "2026-10",
          "result.noi.ytd_budget": 172300,
          "result.noi.ytd_actual": 164177.3,
          "result.items.0.account": "5600"
        },
        "contains": [
          "2 account(s) need a variance explanation",
          "1 already explained"
        ]
      }
    },
    {
      "id": "month-variance",
      "tool": "budget_explain",
      "args": {
        "budget": "fixtures/budget-2026.csv",
        "actuals": "fixtures/actuals-t12-2026-11.csv",
        "policy": "fixtures/budget-policy.json",
        "as_of": "2026-11-15",
        "account": "5600"
      },
      "expect": {
        "contains": [
          "Month: expense over budget by 2100 (210%)",
          "unfavorable"
        ]
      }
    },
    {
      "id": "explained-and-forecast",
      "tool": "budget_explain",
      "args": {
        "budget": "fixtures/budget-2026.csv",
        "actuals": "fixtures/actuals-t12-2026-11.csv",
        "policy": "fixtures/budget-policy.json",
        "as_of": "2026-11-15",
        "account": "5000"
      },
      "expect": {
        "contains": [
          "forecast_over_annual",
          "sewer line"
        ],
        "equals": {
          "result.item.status": "explained"
        }
      }
    },
    {
      "id": "unfavorable-only",
      "tool": "budget_check",
      "args": {
        "budget": "fixtures/budget-2026.csv",
        "actuals": "fixtures/actuals-t12-2026-11.csv",
        "as_of": "2026-10-31"
      },
      "expect": {
        "contains": [
          "need a variance explanation"
        ]
      }
    },
    {
      "id": "unbudgeted-income-is-a-note",
      "tool": "budget_explain",
      "args": {
        "budget": "fixtures/budget-2026.csv",
        "actuals": "fixtures/actuals-t12-2026-11.csv",
        "policy": "fixtures/budget-policy.json",
        "as_of": "2026-11-15",
        "account": "4300"
      },
      "expect": {
        "equals": {
          "result.item.status": "note"
        }
      }
    },
    {
      "id": "japanese-budget",
      "tool": "budget_check",
      "args": {
        "budget": "fixtures/exports/yosan-ja.csv",
        "as_of": "2026-10-31"
      },
      "expect": {
        "contains": [
          "NOI 670000 against a budget of 870000"
        ]
      }
    },
    {
      "id": "memo",
      "tool": "budget_draft_memo",
      "mode": "auto",
      "auto_actions": [
        "budget_draft_memo"
      ],
      "args": {
        "budget": "fixtures/budget-2026.csv",
        "actuals": "fixtures/actuals-t12-2026-11.csv",
        "policy": "fixtures/budget-policy.json",
        "as_of": "2026-11-15"
      },
      "expect": {
        "status": "executed",
        "contains": [
          "TO CONFIRM: explanation"
        ]
      }
    },
    {
      "id": "never-changes-budget",
      "tool": "budget_update",
      "mode": "auto",
      "args": {},
      "expect": {
        "status": "blocked"
      }
    },
    {
      "id": "send-is-one-click",
      "tool": "budget_request_send",
      "mode": "auto",
      "args": {
        "draft": "x.md",
        "draft_sha256": "0"
      },
      "expect": {
        "status": "needs_approval"
      }
    },
    {
      "id": "writes-report",
      "tool": "budget_write_report",
      "args": {
        "budget": "fixtures/budget-2026.csv",
        "actuals": "fixtures/actuals-t12-2026-11.csv",
        "policy": "fixtures/budget-policy.json",
        "as_of": "2026-11-15"
      },
      "expect": {
        "contains": [
          ".csv",
          ".html"
        ]
      }
    },
    {
      "id": "invented-tool-name-refused",
      "tool": "budget_fix_everything_now",
      "args": {},
      "expect": {
        "status": "blocked"
      }
    },
    {
      "id": "file-outside-root-refused",
      "tool": "budget_check",
      "args": {
        "budget": "../../outside.csv",
        "actuals": "fixtures/actuals-t12-2026-11.csv",
        "policy": "fixtures/budget-policy.json",
        "as_of": "2026-11-15"
      },
      "expect": {
        "status": "error",
        "contains": [
          "outside"
        ]
      }
    },
    {
      "id": "review-mode-still-reads",
      "tool": "budget_check",
      "mode": "review",
      "args": {
        "budget": "fixtures/budget-2026.csv",
        "actuals": "fixtures/actuals-t12-2026-11.csv",
        "policy": "fixtures/budget-policy.json",
        "as_of": "2026-11-15"
      },
      "expect": {
        "status": "executed",
        "equals": {
          "result.month": "2026-10",
          "result.noi.ytd_budget": 172300,
          "result.noi.ytd_actual": 164177.3,
          "result.items.0.account": "5600"
        },
        "contains": [
          "2 account(s) need a variance explanation",
          "1 already explained"
        ]
      }
    },
    {
      "id": "missing-argument-named",
      "tool": "budget_check",
      "args": {
        "actuals": "fixtures/actuals-t12-2026-11.csv",
        "policy": "fixtures/budget-policy.json",
        "as_of": "2026-11-15"
      },
      "expect": {
        "status": "error",
        "contains": [
          "budget"
        ]
      }
    },
    {
      "id": "draft-waits-for-a-person",
      "tool": "budget_draft_memo",
      "args": {
        "budget": "fixtures/budget-2026.csv",
        "actuals": "fixtures/actuals-t12-2026-11.csv",
        "policy": "fixtures/budget-policy.json",
        "as_of": "2026-11-15"
      },
      "expect": {
        "status": "needs_approval",
        "decision": "ask"
      }
    },
    {
      "id": "draft-after-approval",
      "tool": "budget_draft_memo",
      "approve": "Dana Example",
      "args": {
        "budget": "fixtures/budget-2026.csv",
        "actuals": "fixtures/actuals-t12-2026-11.csv",
        "policy": "fixtures/budget-policy.json",
        "as_of": "2026-11-15"
      },
      "expect": {
        "status": "executed",
        "contains": [
          "Nothing was sent"
        ]
      }
    },
    {
      "id": "review-mode-drafts-nothing",
      "tool": "budget_draft_memo",
      "mode": "review",
      "args": {
        "budget": "fixtures/budget-2026.csv",
        "actuals": "fixtures/actuals-t12-2026-11.csv",
        "policy": "fixtures/budget-policy.json",
        "as_of": "2026-11-15"
      },
      "expect": {
        "status": "blocked"
      }
    },
    {
      "id": "missing-file-named",
      "tool": "budget_check",
      "args": {
        "budget": "fixtures/missing-export.csv",
        "actuals": "fixtures/actuals-t12-2026-11.csv",
        "policy": "fixtures/budget-policy.json",
        "as_of": "2026-11-15"
      },
      "expect": {
        "status": "error",
        "contains": [
          "not found",
          "missing-export.csv"
        ]
      }
    }
  ]
}
