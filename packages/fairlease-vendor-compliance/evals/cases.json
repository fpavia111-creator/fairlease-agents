{
  "suite": "fairlease-vendor-compliance",
  "root": "..",
  "data_note": "Fictional vendors, requirements and payments in ../fixtures. Tax IDs are fictional. Deterministic checks; no model is called.",
  "cases": [
    {
      "id": "totals",
      "tool": "vendors_check",
      "args": {
        "vendors": "fixtures/vendor-directory-appfolio.csv",
        "requirements": "fixtures/vendor-requirements.json",
        "payments": "fixtures/payments-2026.csv",
        "as_of": "2026-11-15"
      },
      "expect": {
        "status": "executed",
        "equals": {
          "result.items.length": 8,
          "result.items.0.vendor": "ApplianceCare (fictional)",
          "result.items.0.paid_while_noncompliant": 2900
        },
        "contains": [
          "Paid 4405"
        ]
      }
    },
    {
      "id": "tax-ids-masked",
      "tool": "vendors_check",
      "args": {
        "vendors": "fixtures/vendor-directory-appfolio.csv",
        "requirements": "fixtures/vendor-requirements.json",
        "as_of": "2026-11-15"
      },
      "expect": {
        "contains": [
          "••••••6781"
        ]
      }
    },
    {
      "id": "expired-and-paid",
      "tool": "vendors_explain",
      "args": {
        "vendors": "fixtures/vendor-directory-appfolio.csv",
        "requirements": "fixtures/vendor-requirements.json",
        "payments": "fixtures/payments-2026.csv",
        "as_of": "2026-11-15",
        "vendor": "QuickFix"
      },
      "expect": {
        "contains": [
          "gl_expired",
          "license_expiring",
          "2026-11-12 480"
        ],
        "equals": {
          "result.item.paid_while_noncompliant": 480
        }
      }
    },
    {
      "id": "trade-adds-licence",
      "tool": "vendors_explain",
      "args": {
        "vendors": "fixtures/vendor-directory-appfolio.csv",
        "requirements": "fixtures/vendor-requirements.json",
        "as_of": "2026-11-15",
        "vendor": "Volt"
      },
      "expect": {
        "contains": [
          "license_expired",
          "tax_id_missing"
        ]
      }
    },
    {
      "id": "exemption",
      "tool": "vendors_explain",
      "args": {
        "vendors": "fixtures/vendor-directory-appfolio.csv",
        "requirements": "fixtures/vendor-requirements.json",
        "as_of": "2026-11-15",
        "vendor": "Sparkle"
      },
      "expect": {
        "equals": {
          "result.item.status": "ok"
        }
      }
    },
    {
      "id": "portuguese-directory",
      "tool": "vendors_check",
      "args": {
        "vendors": "fixtures/exports/fornecedores-pt.csv",
        "requirements": "fixtures/vendor-requirements.json",
        "as_of": "2026-11-15"
      },
      "expect": {
        "contains": [
          "license_expired",
          "2026-09-30"
        ]
      }
    },
    {
      "id": "nothing-to-request",
      "tool": "vendors_draft_request",
      "mode": "auto",
      "auto_actions": [
        "vendors_draft_request"
      ],
      "args": {
        "vendors": "fixtures/vendor-directory-appfolio.csv",
        "requirements": "fixtures/vendor-requirements.json",
        "as_of": "2026-11-15",
        "vendor": "FlowRight Plumbing (fictional)"
      },
      "expect": {
        "status": "error",
        "contains": [
          "nothing expired"
        ]
      }
    },
    {
      "id": "never-pays",
      "tool": "approve_invoice",
      "mode": "auto",
      "args": {},
      "expect": {
        "status": "blocked"
      }
    },
    {
      "id": "send-is-one-click",
      "tool": "vendors_request_send",
      "mode": "auto",
      "args": {
        "draft": "x.md",
        "draft_sha256": "0"
      },
      "expect": {
        "status": "needs_approval"
      }
    },
    {
      "id": "writes-report",
      "tool": "vendors_write_report",
      "args": {
        "vendors": "fixtures/vendor-directory-appfolio.csv",
        "requirements": "fixtures/vendor-requirements.json",
        "payments": "fixtures/payments-2026.csv",
        "as_of": "2026-11-15"
      },
      "expect": {
        "contains": [
          ".csv",
          ".html"
        ]
      }
    },
    {
      "id": "invented-tool-name-refused",
      "tool": "vendors_fix_everything_now",
      "args": {},
      "expect": {
        "status": "blocked"
      }
    },
    {
      "id": "file-outside-root-refused",
      "tool": "vendors_check",
      "args": {
        "vendors": "../../outside.csv",
        "requirements": "fixtures/vendor-requirements.json",
        "payments": "fixtures/payments-2026.csv",
        "as_of": "2026-11-15"
      },
      "expect": {
        "status": "error",
        "contains": [
          "outside"
        ]
      }
    },
    {
      "id": "review-mode-still-reads",
      "tool": "vendors_check",
      "mode": "review",
      "args": {
        "vendors": "fixtures/vendor-directory-appfolio.csv",
        "requirements": "fixtures/vendor-requirements.json",
        "payments": "fixtures/payments-2026.csv",
        "as_of": "2026-11-15"
      },
      "expect": {
        "status": "executed",
        "equals": {
          "result.items.length": 8,
          "result.items.0.vendor": "ApplianceCare (fictional)",
          "result.items.0.paid_while_noncompliant": 2900
        },
        "contains": [
          "Paid 4405"
        ]
      }
    },
    {
      "id": "missing-argument-named",
      "tool": "vendors_check",
      "args": {
        "requirements": "fixtures/vendor-requirements.json",
        "payments": "fixtures/payments-2026.csv",
        "as_of": "2026-11-15"
      },
      "expect": {
        "status": "error",
        "contains": [
          "vendors"
        ]
      }
    },
    {
      "id": "draft-waits-for-a-person",
      "tool": "vendors_draft_request",
      "args": {
        "vendors": "fixtures/vendor-directory-appfolio.csv",
        "requirements": "fixtures/vendor-requirements.json",
        "as_of": "2026-11-15",
        "vendor": "QuickFix HVAC (fictional)"
      },
      "expect": {
        "status": "needs_approval",
        "decision": "ask"
      }
    },
    {
      "id": "draft-after-approval",
      "tool": "vendors_draft_request",
      "approve": "Dana Example",
      "args": {
        "vendors": "fixtures/vendor-directory-appfolio.csv",
        "requirements": "fixtures/vendor-requirements.json",
        "as_of": "2026-11-15",
        "vendor": "QuickFix HVAC (fictional)"
      },
      "expect": {
        "status": "executed",
        "contains": [
          "Nothing was sent"
        ]
      }
    },
    {
      "id": "review-mode-drafts-nothing",
      "tool": "vendors_draft_request",
      "mode": "review",
      "args": {
        "vendors": "fixtures/vendor-directory-appfolio.csv",
        "requirements": "fixtures/vendor-requirements.json",
        "as_of": "2026-11-15",
        "vendor": "QuickFix HVAC (fictional)"
      },
      "expect": {
        "status": "blocked"
      }
    },
    {
      "id": "two-trades-duplicate-row-void-and-unlisted-payee",
      "tool": "vendors_check",
      "args": {
        "vendors": "fixtures/vendor-directory-edge-cases.csv",
        "requirements": "fixtures/vendor-requirements.json",
        "payments": "fixtures/payments-edge-cases.csv",
        "as_of": "2026-11-15"
      },
      "expect": {
        "status": "executed",
        "contains": [
          "duplicate_vendor",
          "Paid 1050 to vendors while out of compliance",
          "1 payee(s) paid 900 are not in the vendor directory",
          "license_missing",
          "gl_expiring"
        ],
        "equals": {
          "result.unlisted_payees.0.payee": "Cash Handyman (fictional)"
        }
      }
    },
    {
      "id": "missing-file-named",
      "tool": "vendors_check",
      "args": {
        "vendors": "fixtures/missing-export.csv",
        "requirements": "fixtures/vendor-requirements.json",
        "payments": "fixtures/payments-2026.csv",
        "as_of": "2026-11-15"
      },
      "expect": {
        "status": "error",
        "contains": [
          "not found",
          "missing-export.csv"
        ]
      }
    }
  ]
}
