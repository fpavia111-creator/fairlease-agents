{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.fpavia111-creator/lapis-of-payouts",
  "title": "Lapis of Payouts",
  "description": "Lapis of Payouts: reconciles short-term rental payouts from Airbnb, Vrbo and other channels…",
  "version": "0.1.0",
  "repository": {
    "url": "https://github.com/fpavia111-creator/keystone-agents",
    "source": "github",
    "subfolder": "packages/lapis-of-payouts"
  },
  "websiteUrl": "https://fair-agents.com/fairlease.html",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "lapis-of-payouts",
      "version": "0.1.0",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        },
        {
          "type": "named",
          "name": "--root",
          "description": "Folder holding the exports this agent may read and write (it cannot reach outside it)",
          "isRequired": true,
          "format": "filepath",
          "valueHint": "exports_folder"
        }
      ]
    }
  ]
}
