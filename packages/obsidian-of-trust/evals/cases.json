{
  "suite": "obsidian-of-trust",
  "root": "..",
  "data_note": "Fictional trust bank statement, check register and ledgers in ../fixtures. Deterministic checks; no model is called.",
  "cases": [
    {
      "id": "three-way",
      "tool": "obsidian_check",
      "args": {
        "bank": "fixtures/bank-statement-2026.csv",
        "book": "fixtures/trust-register-2026.csv",
        "ledgers": "fixtures/trust-ledgers-2026-10.csv",
        "policy": "fixtures/trust-policy.json"
      },
      "expect": {
        "status": "executed",
        "equals": {
          "result.balanced": false,
          "result.three_way.adjusted_bank_balance": 57291,
          "result.three_way.book_balance": 58666,
          "result.three_way.ledger_total": 58666,
          "result.three_way.unexplained_bank_book": 0
        },
        "contains": [
          "all of it bank items missing from the book"
        ]
      }
    },
    {
      "id": "returned-payment",
      "tool": "obsidian_check",
      "args": {
        "bank": "fixtures/bank-statement-2026.csv",
        "book": "fixtures/trust-register-2026.csv",
        "policy": "fixtures/trust-policy.json"
      },
      "expect": {
        "contains": [
          "returned_item_not_in_book",
          "reverse the receipt"
        ]
      }
    },
    {
      "id": "duplicate",
      "tool": "obsidian_explain",
      "args": {
        "bank": "fixtures/bank-statement-2026.csv",
        "book": "fixtures/trust-register-2026.csv",
        "policy": "fixtures/trust-policy.json",
        "reference": "2202"
      },
      "expect": {
        "contains": [
          "possible_duplicate",
          "entered twice"
        ]
      }
    },
    {
      "id": "stale",
      "tool": "obsidian_explain",
      "args": {
        "bank": "fixtures/bank-statement-2026.csv",
        "book": "fixtures/trust-register-2026.csv",
        "policy": "fixtures/trust-policy.json",
        "reference": "2150"
      },
      "expect": {
        "contains": [
          "Outstanding 111 days",
          "unclaimed property"
        ]
      }
    },
    {
      "id": "negative-ledger",
      "tool": "obsidian_explain",
      "args": {
        "bank": "fixtures/bank-statement-2026.csv",
        "book": "fixtures/trust-register-2026.csv",
        "ledgers": "fixtures/trust-ledgers-2026-10.csv",
        "policy": "fixtures/trust-policy.json",
        "reference": "Pine Street Partners (fictional)"
      },
      "expect": {
        "contains": [
          "negative balance of -350"
        ]
      }
    },
    {
      "id": "german-bank",
      "tool": "obsidian_check",
      "args": {
        "bank": "fixtures/exports/kontoauszug-de.csv",
        "book": "fixtures/trust-register-2026.csv",
        "policy": "fixtures/trust-policy.json"
      },
      "expect": {
        "equals": {
          "result.three_way.bank_statement_balance": 58846,
          "result.three_way.adjusted_bank_balance": 57291
        }
      }
    },
    {
      "id": "never-moves-money",
      "tool": "transfer_funds",
      "mode": "auto",
      "args": {},
      "expect": {
        "status": "blocked"
      }
    },
    {
      "id": "never-voids",
      "tool": "void_check",
      "mode": "auto",
      "args": {},
      "expect": {
        "status": "blocked"
      }
    },
    {
      "id": "writes-report",
      "tool": "obsidian_write_report",
      "args": {
        "bank": "fixtures/bank-statement-2026.csv",
        "book": "fixtures/trust-register-2026.csv",
        "ledgers": "fixtures/trust-ledgers-2026-10.csv",
        "policy": "fixtures/trust-policy.json"
      },
      "expect": {
        "contains": [
          ".csv",
          ".html"
        ]
      }
    },
    {
      "id": "invented-tool-name-refused",
      "tool": "obsidian_fix_everything_now",
      "args": {},
      "expect": {
        "status": "blocked"
      }
    },
    {
      "id": "file-outside-root-refused",
      "tool": "obsidian_check",
      "args": {
        "bank": "../../outside.csv",
        "book": "fixtures/trust-register-2026.csv",
        "ledgers": "fixtures/trust-ledgers-2026-10.csv",
        "policy": "fixtures/trust-policy.json"
      },
      "expect": {
        "status": "error",
        "contains": [
          "outside"
        ]
      }
    },
    {
      "id": "review-mode-still-reads",
      "tool": "obsidian_check",
      "mode": "review",
      "args": {
        "bank": "fixtures/bank-statement-2026.csv",
        "book": "fixtures/trust-register-2026.csv",
        "ledgers": "fixtures/trust-ledgers-2026-10.csv",
        "policy": "fixtures/trust-policy.json"
      },
      "expect": {
        "status": "executed",
        "equals": {
          "result.balanced": false,
          "result.three_way.adjusted_bank_balance": 57291,
          "result.three_way.book_balance": 58666,
          "result.three_way.ledger_total": 58666,
          "result.three_way.unexplained_bank_book": 0
        },
        "contains": [
          "all of it bank items missing from the book"
        ]
      }
    },
    {
      "id": "missing-argument-named",
      "tool": "obsidian_check",
      "args": {
        "book": "fixtures/trust-register-2026.csv",
        "ledgers": "fixtures/trust-ledgers-2026-10.csv",
        "policy": "fixtures/trust-policy.json"
      },
      "expect": {
        "status": "error",
        "contains": [
          "bank"
        ]
      }
    },
    {
      "id": "check-number-spelling-trace-number-and-newest-first",
      "tool": "obsidian_check",
      "args": {
        "bank": "fixtures/bank-statement-edge-cases.csv",
        "book": "fixtures/trust-register-edge-cases.csv",
        "ledgers": "fixtures/trust-ledgers-edge-cases.csv",
        "policy": "fixtures/trust-policy-edge-cases.json"
      },
      "expect": {
        "status": "executed",
        "contains": [
          "cleared_for_different_amount",
          "negative_ledgers",
          "Not reconciled"
        ],
        "not_contains": [
          "All three agree",
          "statement_does_not_add_up"
        ],
        "equals": {
          "result.three_way.bank_statement_balance": 11200,
          "result.three_way.bank_minus_book": -50,
          "result.balanced": false,
          "result.three_way.outstanding_checks": 0
        }
      }
    },
    {
      "id": "explain-differently-cleared-check",
      "tool": "obsidian_explain",
      "args": {
        "bank": "fixtures/bank-statement-edge-cases.csv",
        "book": "fixtures/trust-register-edge-cases.csv",
        "ledgers": "fixtures/trust-ledgers-edge-cases.csv",
        "policy": "fixtures/trust-policy-edge-cases.json",
        "reference": "3001"
      },
      "expect": {
        "status": "executed",
        "contains": [
          "cleared for -1150; the book has -1100"
        ]
      }
    }
  ]
}
