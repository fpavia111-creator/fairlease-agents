{
  "suite": "fairlease-unit-inspections",
  "root": "..",
  "data_note": "Fictional Maple Court inspections, rent roll and work orders in ../fixtures. Deterministic checks; no model is called.",
  "cases": [
    {
      "id": "totals",
      "tool": "inspections_check",
      "args": {
        "inspections": "fixtures/inspections-2026.csv",
        "policy": "fixtures/inspection-policy.json",
        "rent_roll": "fixtures/rent-roll-2026-11.csv",
        "work_orders": "fixtures/work-orders.csv",
        "as_of": "2026-11-15"
      },
      "expect": {
        "status": "executed",
        "equals": {
          "result.items.length": 24,
          "result.items.0.unit": "106"
        },
        "contains": [
          "1 overdue",
          "1 never inspected",
          "(4 item(s))"
        ]
      }
    },
    {
      "id": "move-out-vs-move-in",
      "tool": "inspections_explain",
      "args": {
        "inspections": "fixtures/inspections-2026.csv",
        "policy": "fixtures/inspection-policy.json",
        "rent_roll": "fixtures/rent-roll-2026-11.csv",
        "work_orders": "fixtures/work-orders.csv",
        "as_of": "2026-11-15",
        "unit": "204"
      },
      "expect": {
        "contains": [
          "Carpet: Good → Damaged (photo)",
          "no_photo",
          "Bathroom: Mirror"
        ],
        "equals": {
          "result.item.worse.length": 4
        }
      }
    },
    {
      "id": "no-baseline",
      "tool": "inspections_explain",
      "args": {
        "inspections": "fixtures/inspections-2026.csv",
        "policy": "fixtures/inspection-policy.json",
        "rent_roll": "fixtures/rent-roll-2026-11.csv",
        "as_of": "2026-11-15",
        "unit": "305"
      },
      "expect": {
        "contains": [
          "no_move_in_baseline"
        ]
      }
    },
    {
      "id": "poor-no-work-order",
      "tool": "inspections_explain",
      "args": {
        "inspections": "fixtures/inspections-2026.csv",
        "policy": "fixtures/inspection-policy.json",
        "rent_roll": "fixtures/rent-roll-2026-11.csv",
        "work_orders": "fixtures/work-orders.csv",
        "as_of": "2026-11-15",
        "unit": "202"
      },
      "expect": {
        "contains": [
          "poor_no_work_order",
          "Smoke detector: Missing"
        ]
      }
    },
    {
      "id": "work-order-followed",
      "tool": "inspections_explain",
      "args": {
        "inspections": "fixtures/inspections-2026.csv",
        "policy": "fixtures/inspection-policy.json",
        "rent_roll": "fixtures/rent-roll-2026-11.csv",
        "work_orders": "fixtures/work-orders.csv",
        "as_of": "2026-11-15",
        "unit": "301"
      },
      "expect": {
        "equals": {
          "result.item.status": "ok"
        }
      }
    },
    {
      "id": "german-export",
      "tool": "inspections_check",
      "args": {
        "inspections": "fixtures/exports/begehung-de.csv",
        "policy": "fixtures/inspection-policy.json",
        "as_of": "2026-11-15"
      },
      "expect": {
        "contains": [
          "Teppich gut → beschädigt",
          "1 overdue"
        ]
      }
    },
    {
      "id": "vacant-no-notice",
      "tool": "inspections_draft_notice",
      "mode": "auto",
      "auto_actions": [
        "inspections_draft_notice"
      ],
      "args": {
        "inspections": "fixtures/inspections-2026.csv",
        "policy": "fixtures/inspection-policy.json",
        "rent_roll": "fixtures/rent-roll-2026-11.csv",
        "as_of": "2026-11-15",
        "unit": "204"
      },
      "expect": {
        "status": "error",
        "contains": [
          "vacant"
        ]
      }
    },
    {
      "id": "not-due",
      "tool": "inspections_draft_notice",
      "mode": "auto",
      "auto_actions": [
        "inspections_draft_notice"
      ],
      "args": {
        "inspections": "fixtures/inspections-2026.csv",
        "policy": "fixtures/inspection-policy.json",
        "rent_roll": "fixtures/rent-roll-2026-11.csv",
        "as_of": "2026-11-15",
        "unit": "101"
      },
      "expect": {
        "status": "error",
        "contains": [
          "not due"
        ]
      }
    },
    {
      "id": "never-charges",
      "tool": "post_tenant_charge",
      "mode": "auto",
      "args": {},
      "expect": {
        "status": "blocked"
      }
    },
    {
      "id": "never-dispatches",
      "tool": "vendor_dispatch",
      "mode": "auto",
      "args": {},
      "expect": {
        "status": "blocked"
      }
    },
    {
      "id": "send-is-one-click",
      "tool": "inspections_request_send",
      "mode": "auto",
      "args": {
        "draft": "x.md",
        "draft_sha256": "0"
      },
      "expect": {
        "status": "needs_approval"
      }
    },
    {
      "id": "writes-report",
      "tool": "inspections_write_report",
      "args": {
        "inspections": "fixtures/inspections-2026.csv",
        "policy": "fixtures/inspection-policy.json",
        "rent_roll": "fixtures/rent-roll-2026-11.csv",
        "work_orders": "fixtures/work-orders.csv",
        "as_of": "2026-11-15"
      },
      "expect": {
        "contains": [
          ".csv",
          ".html"
        ]
      }
    },
    {
      "id": "invented-tool-name-refused",
      "tool": "inspections_fix_everything_now",
      "args": {},
      "expect": {
        "status": "blocked"
      }
    },
    {
      "id": "file-outside-root-refused",
      "tool": "inspections_check",
      "args": {
        "inspections": "../../outside.csv",
        "policy": "fixtures/inspection-policy.json",
        "rent_roll": "fixtures/rent-roll-2026-11.csv",
        "work_orders": "fixtures/work-orders.csv",
        "as_of": "2026-11-15"
      },
      "expect": {
        "status": "error",
        "contains": [
          "outside"
        ]
      }
    },
    {
      "id": "review-mode-still-reads",
      "tool": "inspections_check",
      "mode": "review",
      "args": {
        "inspections": "fixtures/inspections-2026.csv",
        "policy": "fixtures/inspection-policy.json",
        "rent_roll": "fixtures/rent-roll-2026-11.csv",
        "work_orders": "fixtures/work-orders.csv",
        "as_of": "2026-11-15"
      },
      "expect": {
        "status": "executed",
        "equals": {
          "result.items.length": 24,
          "result.items.0.unit": "106"
        },
        "contains": [
          "1 overdue",
          "1 never inspected",
          "(4 item(s))"
        ]
      }
    },
    {
      "id": "missing-argument-named",
      "tool": "inspections_check",
      "args": {
        "policy": "fixtures/inspection-policy.json",
        "rent_roll": "fixtures/rent-roll-2026-11.csv",
        "work_orders": "fixtures/work-orders.csv",
        "as_of": "2026-11-15"
      },
      "expect": {
        "status": "error",
        "contains": [
          "inspections"
        ]
      }
    },
    {
      "id": "draft-waits-for-a-person",
      "tool": "inspections_draft_notice",
      "args": {
        "inspections": "fixtures/inspections-2026.csv",
        "policy": "fixtures/inspection-policy.json",
        "rent_roll": "fixtures/rent-roll-2026-11.csv",
        "as_of": "2026-11-15",
        "unit": "106"
      },
      "expect": {
        "status": "needs_approval",
        "decision": "ask"
      }
    },
    {
      "id": "draft-after-approval",
      "tool": "inspections_draft_notice",
      "approve": "Dana Example",
      "args": {
        "inspections": "fixtures/inspections-2026.csv",
        "policy": "fixtures/inspection-policy.json",
        "rent_roll": "fixtures/rent-roll-2026-11.csv",
        "as_of": "2026-11-15",
        "unit": "106"
      },
      "expect": {
        "status": "executed",
        "contains": [
          "Nothing was sent"
        ]
      }
    },
    {
      "id": "review-mode-drafts-nothing",
      "tool": "inspections_draft_notice",
      "mode": "review",
      "args": {
        "inspections": "fixtures/inspections-2026.csv",
        "policy": "fixtures/inspection-policy.json",
        "rent_roll": "fixtures/rent-roll-2026-11.csv",
        "as_of": "2026-11-15",
        "unit": "106"
      },
      "expect": {
        "status": "blocked"
      }
    },
    {
      "id": "missing-file-named",
      "tool": "inspections_check",
      "args": {
        "inspections": "fixtures/missing-export.csv",
        "policy": "fixtures/inspection-policy.json",
        "rent_roll": "fixtures/rent-roll-2026-11.csv",
        "work_orders": "fixtures/work-orders.csv",
        "as_of": "2026-11-15"
      },
      "expect": {
        "status": "error",
        "contains": [
          "not found",
          "missing-export.csv"
        ]
      }
    }
  ]
}
