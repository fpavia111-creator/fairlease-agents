  "license": "MIT",
  "author": "Kurt Francisco",
  "engines": {
    "node": ">=20"
  },
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "fairlease-estoppel-review": "bin/fairlease-estoppel-review.js"
  },
  "files": [
    "src",
    "bin",
    "fixtures",
    "evals",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "server.json"
  ],
  "scripts": {
    "test": "node scripts/run-tests.cjs",
    "demo": "node bin/fairlease-estoppel-review.js demo",
    "eval": "node bin/fairlease-estoppel-review.js eval"
  },
  "dependencies": {
    "fairlease-core": "^0.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fpavia111-creator/fairlease-agents.git",
    "directory": "packages/fairlease-estoppel-review"
  },
  "homepage": "https://github.com/fpavia111-creator/fairlease-agents/tree/master/packages/fairlease-estoppel-review#readme",
  "bugs": {
    "url": "https://github.com/fpavia111-creator/fairlease-agents/issues"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "property-management",
    "real-estate",
    "keystone",
    "estoppels"
  ]
}
