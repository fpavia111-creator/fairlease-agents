{
  "name": "fairlease-estoppel-review",
  "version": "0.1.0",
  "mcpName": "io.github.fpavia111-creator/fairlease-estoppel-review",
  "description": "Fairlease Estoppel Review: checks returned tenant estoppel certificates against your lease abstracts before a sale or refinancing (rent, dates, deposit, area, options, amendments, landlord defaults claimed), tracks which are missing or stale, and drafts follow-up requests.",
