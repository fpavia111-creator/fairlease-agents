{
  "suite": "jade-of-escalations",
  "root": "..",
  "data_note": "Fictional leases, CPI-style example index values and rent charges in ../fixtures. Deterministic checks; no model is called.",
  "cases": [
    {
      "id": "totals",
      "tool": "jade_check",
      "args": {
        "leases": "fixtures/leases.json",
        "ledger": "fixtures/rent-charges-2025.csv",
        "from": "2025-01",
        "to": "2026-01",
        "indexes": "fixtures/indexes.json"
      },
      "expect": {
        "status": "executed",
        "equals": {
          "result.underbilled_total": 34125.83,
          "result.items.0.net_difference": -1359.6,
          "result.items.1.status": "ok",
          "result.items.3.status": "ok",
          "result.items.5.status": "ok"
        }
      }
    },
    {
      "id": "every-planted-issue-found",
      "tool": "jade_check",
      "args": {
        "leases": "fixtures/leases.json",
        "ledger": "fixtures/rent-charges-2025.csv",
        "from": "2025-01",
        "to": "2026-01",
        "indexes": "fixtures/indexes.json"
      },
      "expect": {
        "contains": [
          "escalation_missed",
          "not_billed",
          "2025-08"
        ]
      }
    },
    {
      "id": "cpi-floor-cap",
      "tool": "jade_explain",
      "args": {
        "leases": "fixtures/leases.json",
        "ledger": "fixtures/rent-charges-2025.csv",
        "from": "2025-01",
        "to": "2026-01",
        "indexes": "fixtures/indexes.json",
        "lease": "L-103"
      },
      "expect": {
        "contains": [
          "CPI 2.74%",
          "CPI 2.06%"
        ],
        "equals": {
          "result.item.lines.0.expected": 13755.25,
          "result.item.lines.12.expected": 14038.64
        }
      }
    },
    {
      "id": "cpi-without-index-is-review",
      "tool": "jade_explain",
      "args": {
        "leases": "fixtures/leases.json",
        "ledger": "fixtures/rent-charges-2025.csv",
        "from": "2025-01",
        "to": "2025-03",
        "lease": "L-103"
      },
      "expect": {
        "contains": [
          "index_missing"
        ],
        "equals": {
          "result.item.status": "review"
        }
      }
    },
    {
      "id": "free-rent-and-part-month",
      "tool": "jade_explain",
      "args": {
        "leases": "fixtures/leases.json",
        "ledger": "fixtures/rent-charges-2025.csv",
        "from": "2025-01",
        "to": "2025-06",
        "lease": "Fable Books"
      },
      "expect": {
        "equals": {
          "result.item.months": 5,
          "result.item.status": "ok"
        }
      }
    },
    {
      "id": "french-ledger",
      "tool": "jade_check",
      "args": {
        "leases": "fixtures/leases.json",
        "ledger": "fixtures/exports/ledger-fr.csv",
        "from": "2025-06",
        "to": "2025-07"
      },
      "expect": {
        "contains": [
          "escalation_missed"
        ],
        "equals": {
          "result.items.3.net_difference": -104,
          "result.items.3.lines.0.code": "ok"
        }
      }
    },
    {
      "id": "upcoming-calendar",
      "tool": "jade_upcoming",
      "args": {
        "leases": "fixtures/leases.json",
        "indexes": "fixtures/indexes.json",
        "as_of": "2026-01-15"
      },
      "expect": {
        "equals": {
          "result.items.length": 2,
          "result.items.0.lease_id": "L-106",
          "result.items.0.to_monthly": 4506.25,
          "result.items.1.date": "2026-03-01"
        }
      }
    },
    {
      "id": "bad-month-refused",
      "tool": "jade_check",
      "args": {
        "leases": "fixtures/leases.json",
        "ledger": "fixtures/rent-charges-2025.csv",
        "from": "last year",
        "to": "2026-01"
      },
      "expect": {
        "status": "error",
        "contains": [
          "YYYY-MM"
        ]
      }
    },
    {
      "id": "never-bills",
      "tool": "post_tenant_charge",
      "mode": "auto",
      "args": {},
      "expect": {
        "status": "blocked"
      }
    },
    {
      "id": "never-changes-system",
      "tool": "pm_system_update",
      "mode": "auto",
      "args": {},
      "expect": {
        "status": "blocked"
      }
    },
    {
      "id": "writes-report",
      "tool": "jade_write_report",
      "args": {
        "leases": "fixtures/leases.json",
        "ledger": "fixtures/rent-charges-2025.csv",
        "from": "2025-01",
        "to": "2026-01",
        "indexes": "fixtures/indexes.json"
      },
      "expect": {
        "contains": [
          ".csv",
          ".html"
        ]
      }
    },
    {
      "id": "invented-tool-name-refused",
      "tool": "jade_fix_everything_now",
      "args": {},
      "expect": {
        "status": "blocked"
      }
    },
    {
      "id": "file-outside-root-refused",
      "tool": "jade_check",
      "args": {
        "leases": "../../outside.csv",
        "ledger": "fixtures/rent-charges-2025.csv",
        "from": "2025-01",
        "to": "2026-01",
        "indexes": "fixtures/indexes.json"
      },
      "expect": {
        "status": "error",
        "contains": [
          "outside"
        ]
      }
    },
    {
      "id": "review-mode-still-reads",
      "tool": "jade_check",
      "mode": "review",
      "args": {
        "leases": "fixtures/leases.json",
        "ledger": "fixtures/rent-charges-2025.csv",
        "from": "2025-01",
        "to": "2026-01",
        "indexes": "fixtures/indexes.json"
      },
      "expect": {
        "status": "executed",
        "equals": {
          "result.underbilled_total": 34125.83,
          "result.items.0.net_difference": -1359.6,
          "result.items.1.status": "ok",
          "result.items.3.status": "ok",
          "result.items.5.status": "ok"
        }
      }
    },
    {
      "id": "missing-argument-named",
      "tool": "jade_check",
      "args": {
        "ledger": "fixtures/rent-charges-2025.csv",
        "from": "2025-01",
        "to": "2026-01",
        "indexes": "fixtures/indexes.json"
      },
      "expect": {
        "status": "error",
        "contains": [
          "leases"
        ]
      }
    },
    {
      "id": "gl-code-read-by-description-and-payment-not-billing",
      "tool": "jade_explain",
      "args": {
        "leases": "fixtures/leases.json",
        "ledger": "fixtures/rent-charges-edge-cases.csv",
        "from": "2026-03",
        "to": "2026-03",
        "lease": "L-101"
      },
      "expect": {
        "status": "executed",
        "equals": {
          "result.item.billed_total": 4370.91,
          "result.item.status": "ok"
        }
      }
    },
    {
      "id": "billed-after-lease-end",
      "tool": "jade_explain",
      "args": {
        "leases": "fixtures/leases.json",
        "ledger": "fixtures/rent-charges-edge-cases.csv",
        "from": "2026-04",
        "to": "2026-05",
        "lease": "L-104"
      },
      "expect": {
        "status": "executed",
        "contains": [
          "billed_outside_term",
          "2024-05-01 to 2026-04-30"
        ],
        "not_contains": [
          "billed_during_free_rent"
        ]
      }
    },
    {
      "id": "billed-twice-matched-by-unit-spelling",
      "tool": "jade_explain",
      "args": {
        "leases": "fixtures/leases.json",
        "ledger": "fixtures/rent-charges-edge-cases.csv",
        "from": "2026-03",
        "to": "2026-03",
        "lease": "L-106"
      },
      "expect": {
        "status": "executed",
        "contains": [
          "billed_twice"
        ],
        "equals": {
          "result.item.net_difference": 4506.25
        }
      }
    }
  ]
}
