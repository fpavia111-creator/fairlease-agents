{
  "suite": "feldspar-of-estoppels",
  "root": "..",
  "data_note": "Fictional lease abstracts, estoppel logs and index values in ../fixtures. Deterministic checks; no model is called.",
  "cases": [
    {"id": "coverage", "tool": "feldspar_check", "args": {"leases": "fixtures/leases.json", "estoppels": "fixtures/estoppels-2026.csv", "policy": "fixtures/estoppel-policy.json", "indexes": "fixtures/indexes.json", "as_of": "2026-11-15"}, "expect": {"status": "executed", "equals": {"result.coverage.returned": 4, "result.coverage.pct_returned": 92.96, "result.coverage.meets_requirement": true, "result.unmatched_estoppels.length": 1}, "contains": ["1 claiming a landlord default"]}},
    {"id": "stale-and-rent", "tool": "feldspar_explain", "args": {"leases": "fixtures/leases.json", "estoppels": "fixtures/estoppels-2026.csv", "policy": "fixtures/estoppel-policy.json", "as_of": "2026-11-15", "unit": "Suite 110"}, "expect": {"contains": ["75 days before closing 2026-12-15", "rent 7649.09", "7878.56"]}},
    {"id": "default-claimed", "tool": "feldspar_explain", "args": {"leases": "fixtures/leases.json", "estoppels": "fixtures/estoppels-2026.csv", "indexes": "fixtures/indexes.json", "as_of": "2026-11-15", "unit": "L-103"}, "expect": {"contains": ["default_claimed", "offset of 3,200.00"], "equals": {"result.item.expected_rent": 14038.64}}},
    {"id": "cpi-without-index-is-a-note", "tool": "feldspar_explain", "args": {"leases": "fixtures/leases.json", "estoppels": "fixtures/estoppels-2026.csv", "as_of": "2026-11-15", "unit": "L-103"}, "expect": {"contains": ["CPI escalation: give index values"]}},
    {"id": "term-and-amendment", "tool": "feldspar_explain", "args": {"leases": "fixtures/leases.json", "estoppels": "fixtures/estoppels-2026.csv", "as_of": "2026-11-15", "unit": "Suite 140"}, "expect": {"contains": ["expiration_differs", "amendment_not_in_file", "rent_prepaid"]}},
    {"id": "german-log", "tool": "feldspar_check", "args": {"leases": "fixtures/leases.json", "estoppels": "fixtures/exports/mieterbestaetigung-de.csv", "policy": "fixtures/estoppel-policy.json", "indexes": "fixtures/indexes.json", "as_of": "2026-11-15"}, "expect": {"contains": ["deposit 20000", "below the 75% required"]}},
    {"id": "clean-no-request", "tool": "feldspar_draft_request", "mode": "auto", "auto_actions": ["feldspar_draft_request"], "args": {"leases": "fixtures/leases.json", "estoppels": "fixtures/estoppels-2026.csv", "as_of": "2026-11-15", "unit": "Suite 100"}, "expect": {"status": "error", "contains": ["nothing to follow up"]}},
    {"id": "missing-request", "tool": "feldspar_draft_request", "mode": "auto", "auto_actions": ["feldspar_draft_request"], "args": {"leases": "fixtures/leases.json", "estoppels": "fixtures/estoppels-2026.csv", "as_of": "2026-11-15", "unit": "Suite 150"}, "expect": {"status": "executed"}},
    {"id": "never-shares", "tool": "data_room_upload", "mode": "auto", "args": {}, "expect": {"status": "blocked"}},
    {"id": "never-esigns", "tool": "esign_send", "mode": "auto", "args": {}, "expect": {"status": "blocked"}},
    {"id": "send-is-one-click", "tool": "feldspar_request_send", "mode": "auto", "args": {"draft": "x.md", "draft_sha256": "0"}, "expect": {"status": "needs_approval"}}
  ]
}
