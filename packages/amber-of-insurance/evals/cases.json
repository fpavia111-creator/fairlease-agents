{
  "suite": "amber-of-insurance",
  "root": "..",
  "data_note": "Fictional leases and certificate logs in ../fixtures. Deterministic checks; no model is called.",
  "cases": [
    {
      "id": "totals",
      "tool": "amber_check",
      "args": {
        "leases": "fixtures/leases.json",
        "certificates": "fixtures/certificates-2026.csv",
        "as_of": "2026-11-15"
      },
      "expect": {
        "status": "executed",
        "equals": {
          "result.items.length": 5,
          "result.unmatched_certificates.length": 1
        },
        "contains": [
          "1 with no certificate",
          "1 expired",
          "2 short of the lease"
        ]
      }
    },
    {
      "id": "limits-below",
      "tool": "amber_explain",
      "args": {
        "leases": "fixtures/leases.json",
        "certificates": "fixtures/certificates-2026.csv",
        "as_of": "2026-11-15",
        "unit": "Suite 120"
      },
      "expect": {
        "contains": [
          "liability_below",
          "aggregate_below",
          "4,000,000"
        ]
      }
    },
    {
      "id": "additional-insured-and-expiring",
      "tool": "amber_explain",
      "args": {
        "leases": "fixtures/leases.json",
        "certificates": "fixtures/certificates-2026.csv",
        "as_of": "2026-11-15",
        "unit": "L-102"
      },
      "expect": {
        "contains": [
          "additional_insured_missing",
          "expiring"
        ],
        "equals": {
          "result.item.status": "issue"
        }
      }
    },
    {
      "id": "expired",
      "tool": "amber_explain",
      "args": {
        "leases": "fixtures/leases.json",
        "certificates": "fixtures/certificates-2026.csv",
        "as_of": "2026-11-15",
        "unit": "Suite 140"
      },
      "expect": {
        "contains": [
          "Expired 2026-10-31"
        ]
      }
    },
    {
      "id": "ended-lease-unmatched",
      "tool": "amber_check",
      "args": {
        "leases": "fixtures/leases.json",
        "certificates": "fixtures/certificates-2026.csv",
        "as_of": "2026-11-15"
      },
      "expect": {
        "contains": [
          "lease L-104 not in force"
        ]
      }
    },
    {
      "id": "spanish-log",
      "tool": "amber_check",
      "args": {
        "leases": "fixtures/maple-leases.json",
        "certificates": "fixtures/exports/seguros-inquilinos-es.csv",
        "as_of": "2026-11-15"
      },
      "expect": {
        "contains": [
          "Liability 50,000 is below the 100,000",
          "Expired 2026-11-10",
          "month-to-month"
        ]
      }
    },
    {
      "id": "nothing-to-request",
      "tool": "amber_draft_request",
      "mode": "auto",
      "auto_actions": [
        "amber_draft_request"
      ],
      "args": {
        "leases": "fixtures/leases.json",
        "certificates": "fixtures/certificates-2026.csv",
        "as_of": "2026-11-15",
        "unit": "Suite 100"
      },
      "expect": {
        "status": "error",
        "contains": [
          "nothing missing"
        ]
      }
    },
    {
      "id": "draft-request",
      "tool": "amber_draft_request",
      "mode": "auto",
      "auto_actions": [
        "amber_draft_request"
      ],
      "args": {
        "leases": "fixtures/leases.json",
        "certificates": "fixtures/certificates-2026.csv",
        "as_of": "2026-11-15",
        "unit": "Suite 150"
      },
      "expect": {
        "status": "executed"
      }
    },
    {
      "id": "never-force-places",
      "tool": "force_place_insurance",
      "mode": "auto",
      "args": {},
      "expect": {
        "status": "blocked"
      }
    },
    {
      "id": "never-charges",
      "tool": "post_tenant_charge",
      "mode": "auto",
      "args": {},
      "expect": {
        "status": "blocked"
      }
    },
    {
      "id": "send-is-one-click",
      "tool": "amber_request_send",
      "mode": "auto",
      "args": {
        "draft": "x.md",
        "draft_sha256": "0"
      },
      "expect": {
        "status": "needs_approval"
      }
    },
    {
      "id": "writes-report",
      "tool": "amber_write_report",
      "args": {
        "leases": "fixtures/leases.json",
        "certificates": "fixtures/certificates-2026.csv",
        "as_of": "2026-11-15"
      },
      "expect": {
        "contains": [
          ".csv",
          ".html"
        ]
      }
    }
  ]
}
