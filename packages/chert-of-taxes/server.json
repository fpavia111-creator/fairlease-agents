{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.fpavia111-creator/chert-of-taxes",
  "title": "Chert of Taxes",
  "description": "Chert of Taxes: tracks property tax assessments, installments and the appeal deadlines you enter…",
  "version": "0.1.0",
  "repository": {
    "url": "https://github.com/fpavia111-creator/keystone-agents",
    "source": "github",
    "subfolder": "packages/chert-of-taxes"
  },
  "websiteUrl": "https://fair-agents.com/fairlease.html",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "chert-of-taxes",
      "version": "0.1.0",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        },
        {
          "type": "named",
          "name": "--root",
          "description": "Folder holding the exports this agent may read and write (it cannot reach outside it)",
          "isRequired": true,
          "format": "filepath",
          "valueHint": "exports_folder"
        }
      ]
    }
  ]
}
