{
  "name": "cobalt-of-listings",
  "version": "0.1.0",
  "description": "Cobalt of Listings: checks rental listings across your website and listing sites against the rent roll: vacant or soon-vacant units not listed, units listed while occupied, rent, deposit and unit details that differ from the rent roll or between sites, stale dates and duplicates, and listing wording for a person to review; drafts correction requests.",
  "type": "module",
  "license": "MIT",
  "author": "Kurt Francisco",
  "engines": {
    "node": ">=20"
  },
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "cobalt-of-listings": "bin/cobalt-of-listings.js"
  },
  "files": [
    "src",
    "bin",
    "fixtures",
    "evals",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node scripts/run-tests.cjs",
    "demo": "node bin/cobalt-of-listings.js demo",
    "eval": "node bin/cobalt-of-listings.js eval"
  },
  "dependencies": {
    "keystone-core": "^0.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fpavia111-creator/keystone-agents.git",
    "directory": "packages/cobalt-of-listings"
  },
  "homepage": "https://github.com/fpavia111-creator/keystone-agents/tree/main/packages/cobalt-of-listings#readme",
  "bugs": {
    "url": "https://github.com/fpavia111-creator/keystone-agents/issues"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "property-management",
    "real-estate",
    "keystone",
    "listings"
  ]
}
