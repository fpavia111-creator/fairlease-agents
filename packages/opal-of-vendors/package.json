  "license": "MIT",
  "author": "Kurt Francisco",
  "engines": {
    "node": ">=20"
  },
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "opal-of-vendors": "bin/opal-of-vendors.js"
  },
  "files": [
    "src",
    "bin",
    "fixtures",
    "evals",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node scripts/run-tests.cjs",
    "demo": "node bin/opal-of-vendors.js demo",
    "eval": "node bin/opal-of-vendors.js eval"
  },
  "dependencies": {
    "keystone-core": "^0.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fpavia111-creator/keystone-agents.git",
    "directory": "packages/opal-of-vendors"
  },
  "homepage": "https://github.com/fpavia111-creator/keystone-agents/tree/main/packages/opal-of-vendors#readme",
  "bugs": {
    "url": "https://github.com/fpavia111-creator/keystone-agents/issues"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "property-management",
    "real-estate",
    "keystone",
    "vendor-compliance",
    "coi",
    "insurance-certificates"
  ]
}
