{
  "name": "opal-of-vendors",
  "version": "0.1.0",
  "description": "Opal of Vendors: checks every vendor's liability and workers' comp insurance, licence and tax form against your own requirements, finds payments made while a vendor was out of compliance, and drafts certificate requests.",
