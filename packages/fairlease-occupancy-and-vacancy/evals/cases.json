{
  "suite": "fairlease-occupancy-and-vacancy",
  "root": "..",
  "data_note": "Fictional AppFolio-style and Yardi-style rent rolls for a fictional 24-unit building in ../fixtures. Deterministic checks; no model is called.",
  "cases": [
    {
      "id": "totals",
      "tool": "vacancy_check",
      "args": {
        "rent_roll": "fixtures/rent-roll-2026-11.csv",
        "as_of": "2026-11-15"
      },
      "expect": {
        "status": "executed",
        "equals": {
          "result.totals.units": 24,
          "result.totals.physical_occupancy_pct": 87.5,
          "result.totals.leased_pct": 87.5,
          "result.totals.exposure_units": 3,
          "result.totals.loss_to_lease": 850,
          "result.totals.vacancy_loss_monthly": 6350
        }
      }
    },
    {
      "id": "long-vacant",
      "tool": "vacancy_explain",
      "args": {
        "rent_roll": "fixtures/rent-roll-2026-11.csv",
        "as_of": "2026-11-15",
        "unit": "204"
      },
      "expect": {
        "contains": [
          "long_vacant",
          "46 days"
        ],
        "equals": {
          "result.item.vacancy_loss_to_date": 2797.81
        }
      }
    },
    {
      "id": "notice-is-not-vacant",
      "tool": "vacancy_explain",
      "args": {
        "rent_roll": "fixtures/rent-roll-2026-11.csv",
        "as_of": "2026-11-15",
        "unit": "106"
      },
      "expect": {
        "contains": [
          "notice_unrented"
        ],
        "equals": {
          "result.item.status": "notice"
        }
      }
    },
    {
      "id": "off-market-both-ways",
      "tool": "vacancy_check",
      "args": {
        "rent_roll": "fixtures/rent-roll-2026-11.csv",
        "as_of": "2026-11-15"
      },
      "expect": {
        "contains": [
          "below_market",
          "15.15% under",
          "above_market",
          "12.12% over",
          "market_rent_missing"
        ]
      }
    },
    {
      "id": "threshold-argument",
      "tool": "vacancy_check",
      "args": {
        "rent_roll": "fixtures/rent-roll-2026-11.csv",
        "as_of": "2026-11-15",
        "off_market_pct": 20,
        "long_vacant_days": 60
      },
      "expect": {
        "equals": {
          "result.items.0.unit": "306"
        }
      }
    },
    {
      "id": "pre-leased",
      "tool": "vacancy_explain",
      "args": {
        "rent_roll": "fixtures/rent-roll-2026-11.csv",
        "as_of": "2026-11-15",
        "unit": "305"
      },
      "expect": {
        "contains": [
          "move-in 2026-12-01"
        ],
        "equals": {
          "result.item.status": "vacant_rented"
        }
      }
    },
    {
      "id": "yardi-charge-rows",
      "tool": "vacancy_check",
      "args": {
        "rent_roll": "fixtures/exports/yardi-rent-roll-charges.csv",
        "as_of": "2026-11-15"
      },
      "expect": {
        "equals": {
          "result.totals.units": 3,
          "result.totals.concessions": 150,
          "result.totals.vacant": 1,
          "result.items.0.unit": "204"
        }
      }
    },
    {
      "id": "bad-date",
      "tool": "vacancy_check",
      "args": {
        "rent_roll": "fixtures/rent-roll-2026-11.csv",
        "as_of": "soon"
      },
      "expect": {
        "status": "error",
        "contains": [
          "YYYY-MM-DD"
        ]
      }
    },
    {
      "id": "never-reprices",
      "tool": "pm_system_update",
      "mode": "auto",
      "args": {},
      "expect": {
        "status": "blocked"
      }
    },
    {
      "id": "never-lists",
      "tool": "listing_publish",
      "mode": "auto",
      "args": {},
      "expect": {
        "status": "blocked"
      }
    },
    {
      "id": "writes-report",
      "tool": "vacancy_write_report",
      "args": {
        "rent_roll": "fixtures/rent-roll-2026-11.csv",
        "as_of": "2026-11-15"
      },
      "expect": {
        "contains": [
          ".csv",
          ".html"
        ]
      }
    },
    {
      "id": "invented-tool-name-refused",
      "tool": "vacancy_fix_everything_now",
      "args": {},
      "expect": {
        "status": "blocked"
      }
    },
    {
      "id": "file-outside-root-refused",
      "tool": "vacancy_check",
      "args": {
        "rent_roll": "../../outside.csv",
        "as_of": "2026-11-15"
      },
      "expect": {
        "status": "error",
        "contains": [
          "outside"
        ]
      }
    },
    {
      "id": "review-mode-still-reads",
      "tool": "vacancy_check",
      "mode": "review",
      "args": {
        "rent_roll": "fixtures/rent-roll-2026-11.csv",
        "as_of": "2026-11-15"
      },
      "expect": {
        "status": "executed",
        "equals": {
          "result.totals.units": 24,
          "result.totals.physical_occupancy_pct": 87.5,
          "result.totals.leased_pct": 87.5,
          "result.totals.exposure_units": 3,
          "result.totals.loss_to_lease": 850,
          "result.totals.vacancy_loss_monthly": 6350
        }
      }
    },
    {
      "id": "missing-argument-named",
      "tool": "vacancy_check",
      "args": {
        "as_of": "2026-11-15"
      },
      "expect": {
        "status": "error",
        "contains": [
          "rent_roll"
        ]
      }
    },
    {
      "id": "model-and-staff-units-notice-rented-and-zero-rent",
      "tool": "vacancy_check",
      "args": {
        "rent_roll": "fixtures/rent-roll-edge-cases.csv",
        "as_of": "2026-11-15"
      },
      "expect": {
        "status": "executed",
        "contains": [
          "non_revenue_unit",
          "move_out_passed",
          "rent_zero",
          "notice_rented",
          "2 more not for rent"
        ],
        "equals": {
          "result.totals.rentable_units": 5,
          "result.totals.exposure_units": 2,
          "result.totals.physical_occupancy_pct": 80,
          "result.totals.leased_pct": 60,
          "result.totals.gross_potential_rent": 5000
        }
      }
    },
    {
      "id": "explain-zero-rent-unit",
      "tool": "vacancy_explain",
      "args": {
        "rent_roll": "fixtures/rent-roll-edge-cases.csv",
        "as_of": "2026-11-15",
        "unit": "207"
      },
      "expect": {
        "status": "executed",
        "contains": [
          "rent of zero"
        ],
        "not_contains": [
          "below_market"
        ]
      }
    },
    {
      "id": "missing-file-named",
      "tool": "vacancy_check",
      "args": {
        "rent_roll": "fixtures/missing-export.csv",
        "as_of": "2026-11-15"
      },
      "expect": {
        "status": "error",
        "contains": [
          "not found",
          "missing-export.csv"
        ]
      }
    }
  ]
}
