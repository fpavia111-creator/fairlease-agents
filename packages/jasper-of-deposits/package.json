{
  "name": "jasper-of-deposits",
  "version": "0.1.0",
  "description": "Jasper of Deposits: checks every move-out deposit against your own rules (deadline, itemisation, wear and tear, useful-life proration) and drafts the itemised deposit statement. Refunds are a person's job.",
  "type": "module",
  "license": "MIT",
  "author": "Kurt Francisco",
  "engines": {
    "node": ">=20"
  },
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "jasper-of-deposits": "bin/jasper-of-deposits.js"
  },
  "files": [
    "src",
    "bin",
    "fixtures",
    "evals",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node scripts/run-tests.cjs",
    "demo": "node bin/jasper-of-deposits.js demo",
    "eval": "node bin/jasper-of-deposits.js eval"
  },
  "dependencies": {
    "keystone-core": "^0.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fpavia111-creator/keystone-agents.git",
    "directory": "packages/jasper-of-deposits"
  },
  "homepage": "https://github.com/fpavia111-creator/keystone-agents/tree/main/packages/jasper-of-deposits#readme",
  "bugs": {
    "url": "https://github.com/fpavia111-creator/keystone-agents/issues"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "property-management",
    "real-estate",
    "keystone",
    "security-deposits",
    "move-out",
    "residential"
  ]
}
