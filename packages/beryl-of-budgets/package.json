  "license": "MIT",
  "author": "Kurt Francisco",
  "engines": {
    "node": ">=20"
  },
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "beryl-of-budgets": "bin/beryl-of-budgets.js"
  },
  "files": [
    "src",
    "bin",
    "fixtures",
    "evals",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "server.json"
  ],
  "scripts": {
    "test": "node scripts/run-tests.cjs",
    "demo": "node bin/beryl-of-budgets.js demo",
    "eval": "node bin/beryl-of-budgets.js eval"
  },
  "dependencies": {
    "keystone-core": "^0.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fpavia111-creator/keystone-agents.git",
    "directory": "packages/beryl-of-budgets"
  },
  "homepage": "https://github.com/fpavia111-creator/keystone-agents/tree/main/packages/beryl-of-budgets#readme",
  "bugs": {
    "url": "https://github.com/fpavia111-creator/keystone-agents/issues"
  },
