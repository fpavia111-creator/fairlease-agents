{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.fpavia111-creator/beryl-of-budgets",
  "title": "Beryl of Budgets",
  "description": "Beryl of Budgets: compares actuals with the budget by account for the month and year to date…",
  "version": "0.1.0",
  "repository": {
    "url": "https://github.com/fpavia111-creator/keystone-agents",
    "source": "github",
    "subfolder": "packages/beryl-of-budgets"
  },
  "websiteUrl": "https://fair-agents.com/fairlease.html",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "beryl-of-budgets",
      "version": "0.1.0",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        },
        {
          "type": "named",
          "name": "--root",
          "description": "Folder holding the exports this agent may read and write (it cannot reach outside it)",
          "isRequired": true,
          "format": "filepath",
          "valueHint": "exports_folder"
        }
      ]
    }
  ]
}
