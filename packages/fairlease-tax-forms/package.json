{
  "name": "fairlease-tax-forms",
  "version": "0.1.0",
  "mcpName": "io.github.fpavia111-creator/fairlease-tax-forms",
  "description": "Fairlease 1099 Filings: gets vendor and owner 1099s ready: totals each payee's payments for the tax year against the threshold you give, leaves out card payments, flags missing or malformed tax IDs, missing addresses, shared tax IDs and payees not in the directory, and drafts W-9 requests. Tax IDs are always masked.",
  "type": "module",
  "license": "MIT",
  "author": "Kurt Francisco",
  "engines": {
    "node": ">=20"
  },
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "fairlease-tax-forms": "bin/fairlease-tax-forms.js"
  },
  "files": [
    "src",
    "bin",
    "fixtures",
    "evals",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "server.json"
  ],
  "scripts": {
    "test": "node scripts/run-tests.cjs",
    "demo": "node bin/fairlease-tax-forms.js demo",
    "eval": "node bin/fairlease-tax-forms.js eval"
  },
  "dependencies": {
    "fairlease-core": "^0.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fpavia111-creator/fairlease-agents.git",
    "directory": "packages/fairlease-tax-forms"
  },
  "homepage": "https://github.com/fpavia111-creator/fairlease-agents/tree/master/packages/fairlease-tax-forms#readme",
  "bugs": {
    "url": "https://github.com/fpavia111-creator/fairlease-agents/issues"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "property-management",
    "real-estate",
    "keystone",
    "filings"
  ]
}
