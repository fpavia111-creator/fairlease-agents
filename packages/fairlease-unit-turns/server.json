{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.fpavia111-creator/fairlease-unit-turns",
  "title": "Fairlease Unit Turns",
  "description": "Fairlease Unit Turns: tracks unit turns from move-out to make-ready to move-in: days against your…",
  "version": "0.1.0",
  "repository": {
    "url": "https://github.com/fpavia111-creator/fairlease-agents",
    "source": "github",
    "subfolder": "packages/fairlease-unit-turns"
  },
  "websiteUrl": "https://fair-agents.com/fairlease.html",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "fairlease-unit-turns",
      "version": "0.1.0",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        },
        {
          "type": "named",
          "name": "--root",
          "description": "Folder holding the exports this agent may read and write (it cannot reach outside it)",
          "isRequired": true,
          "format": "filepath",
          "valueHint": "exports_folder"
        }
      ]
    }
  ]
}
