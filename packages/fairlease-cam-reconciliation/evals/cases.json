{
  "suite": "fairlease-cam-reconciliation",
  "root": "..",
  "data_note": "Fictional shopping center, leases, GL and tenant ledger in ../fixtures. Deterministic checks; no model is called.",
  "cases": [
    {
      "id": "pools-and-recovery",
      "tool": "cam_check",
      "args": {
        "leases": "fixtures/leases.json",
        "cam": "fixtures/cam-2025.json",
        "gl": "fixtures/gl-2025.csv",
        "billed": "fixtures/cam-billed-2025.csv"
      },
      "expect": {
        "status": "executed",
        "equals": {
          "result.pools_total": 433000,
          "result.pools.1.grossed_up": 69666.67,
          "result.shares_total_pct": 91.75,
          "result.items.0.balance": 754.75,
          "result.items.2.balance": -3266.67
        }
      }
    },
    {
      "id": "every-planted-issue-found",
      "tool": "cam_check",
      "args": {
        "leases": "fixtures/leases.json",
        "cam": "fixtures/cam-2025.json",
        "gl": "fixtures/gl-2025.csv",
        "billed": "fixtures/cam-billed-2025.csv"
      },
      "expect": {
        "contains": [
          "cap_applied",
          "gross_up_applied",
          "expense_stop",
          "pool_excluded",
          "cap_needs_data",
          "estimate_months_missing",
          "unmapped_accounts",
          "7200"
        ]
      }
    },
    {
      "id": "cumulative-cap",
      "tool": "cam_explain",
      "args": {
        "leases": "fixtures/leases.json",
        "cam": "fixtures/cam-2025.json",
        "gl": "fixtures/gl-2025.csv",
        "billed": "fixtures/cam-billed-2025.csv",
        "tenant": "Acme Bagels LLC"
      },
      "expect": {
        "contains": [
          "over the 5% cumulative cap (9922.5); reduced by 1510.83"
        ],
        "equals": {
          "result.item.admin_fee": 2032.25,
          "result.item.total_due": 22354.75
        }
      }
    },
    {
      "id": "expense-stop-anchor",
      "tool": "cam_explain",
      "args": {
        "leases": "fixtures/leases.json",
        "cam": "fixtures/cam-2025.json",
        "gl": "fixtures/gl-2025.csv",
        "billed": "fixtures/cam-billed-2025.csv",
        "tenant": "L-105"
      },
      "expect": {
        "equals": {
          "result.item.total_due": 28333.34,
          "result.item.direction": "credit to tenant"
        }
      }
    },
    {
      "id": "noncumulative-cap-needs-prior-year",
      "tool": "cam_explain",
      "args": {
        "leases": "fixtures/leases.json",
        "cam": "fixtures/cam-2025.json",
        "gl": "fixtures/gl-2025.csv",
        "billed": "fixtures/cam-billed-2025.csv",
        "tenant": "Fable Books"
      },
      "expect": {
        "equals": {
          "result.item.status": "review",
          "result.item.occupied_days": 334
        }
      }
    },
    {
      "id": "estimates-from-lease-without-ledger",
      "tool": "cam_check",
      "args": {
        "leases": "fixtures/leases.json",
        "cam": "fixtures/cam-2025.json",
        "gl": "fixtures/gl-2025.csv"
      },
      "expect": {
        "contains": [
          "estimates_from_lease"
        ],
        "equals": {
          "result.items.1.billed": 34800
        }
      }
    },
    {
      "id": "appfolio-gl-headings",
      "tool": "cam_check",
      "args": {
        "leases": "fixtures/leases.json",
        "cam": "fixtures/cam-2025.json",
        "gl": "fixtures/exports/appfolio-general-ledger.csv"
      },
      "expect": {
        "equals": {
          "result.pools_total": 208000,
          "result.pools.2.total": 48000,
          "result.pools.3.total": 160000
        }
      }
    },
    {
      "id": "german-gl-columns",
      "tool": "cam_check",
      "args": {
        "leases": "fixtures/leases.json",
        "cam": "fixtures/cam-2025.json",
        "gl": "fixtures/exports/gl-de.csv"
      },
      "expect": {
        "equals": {
          "result.pools_total": 51000,
          "result.pools.0.total": 3000
        }
      }
    },
    {
      "id": "bad-cam-file-refused",
      "tool": "cam_check",
      "args": {
        "leases": "fixtures/leases.json",
        "cam": "fixtures/cam-typo.json",
        "gl": "fixtures/gl-2025.csv"
      },
      "expect": {
        "status": "error",
        "contains": [
          "/pools/0/varible"
        ]
      }
    },
    {
      "id": "send-stays-one-click-in-auto",
      "tool": "cam_request_send",
      "mode": "auto",
      "args": {
        "draft": "fixtures/leases.json",
        "draft_sha256": "0"
      },
      "expect": {
        "status": "needs_approval",
        "decision": "ask"
      }
    },
    {
      "id": "accept-learning-stays-one-click",
      "tool": "cam_accept_learning",
      "mode": "auto",
      "args": {
        "id": "MEM-000000000000",
        "decision": "accept"
      },
      "expect": {
        "status": "needs_approval",
        "decision": "ask"
      }
    },
    {
      "id": "never-posts",
      "tool": "post_tenant_charge",
      "mode": "auto",
      "args": {},
      "expect": {
        "status": "blocked"
      }
    },
    {
      "id": "never-emails",
      "tool": "email_send",
      "mode": "auto",
      "args": {},
      "expect": {
        "status": "blocked"
      }
    },
    {
      "id": "writes-report",
      "tool": "cam_write_report",
      "args": {
        "leases": "fixtures/leases.json",
        "cam": "fixtures/cam-2025.json",
        "gl": "fixtures/gl-2025.csv",
        "billed": "fixtures/cam-billed-2025.csv"
      },
      "expect": {
        "contains": [
          ".csv",
          ".html"
        ]
      }
    },
    {
      "id": "statement-draft-waits",
      "tool": "cam_draft_statement",
      "args": {
        "leases": "fixtures/leases.json",
        "cam": "fixtures/cam-2025.json",
        "gl": "fixtures/gl-2025.csv",
        "billed": "fixtures/cam-billed-2025.csv",
        "tenant": "L-102"
      },
      "expect": {
        "status": "needs_approval",
        "decision": "ask"
      }
    },
    {
      "id": "recall-empty-memory",
      "tool": "cam_recall",
      "args": {},
      "expect": {
        "contains": [
          "memory is empty",
          "verifies"
        ]
      }
    },
    {
      "id": "invented-tool-name-refused",
      "tool": "cam_fix_everything_now",
      "args": {},
      "expect": {
        "status": "blocked"
      }
    },
    {
      "id": "file-outside-root-refused",
      "tool": "cam_check",
      "args": {
        "leases": "../../outside.csv",
        "cam": "fixtures/cam-2025.json",
        "gl": "fixtures/gl-2025.csv",
        "billed": "fixtures/cam-billed-2025.csv"
      },
      "expect": {
        "status": "error",
        "contains": [
          "outside"
        ]
      }
    },
    {
      "id": "review-mode-still-reads",
      "tool": "cam_check",
      "mode": "review",
      "args": {
        "leases": "fixtures/leases.json",
        "cam": "fixtures/cam-2025.json",
        "gl": "fixtures/gl-2025.csv",
        "billed": "fixtures/cam-billed-2025.csv"
      },
      "expect": {
        "status": "executed",
        "equals": {
          "result.pools_total": 433000,
          "result.pools.1.grossed_up": 69666.67,
          "result.shares_total_pct": 91.75,
          "result.items.0.balance": 754.75,
          "result.items.2.balance": -3266.67
        }
      }
    },
    {
      "id": "missing-argument-named",
      "tool": "cam_check",
      "args": {
        "cam": "fixtures/cam-2025.json",
        "gl": "fixtures/gl-2025.csv",
        "billed": "fixtures/cam-billed-2025.csv"
      },
      "expect": {
        "status": "error",
        "contains": [
          "leases"
        ]
      }
    },
    {
      "id": "draft-waits-for-a-person",
      "tool": "cam_draft_statement",
      "args": {
        "leases": "fixtures/leases.json",
        "cam": "fixtures/cam-2025.json",
        "gl": "fixtures/gl-2025.csv",
        "billed": "fixtures/cam-billed-2025.csv",
        "tenant": "L-102"
      },
      "expect": {
        "status": "needs_approval",
        "decision": "ask"
      }
    },
    {
      "id": "draft-after-approval",
      "tool": "cam_draft_statement",
      "approve": "Dana Example",
      "args": {
        "leases": "fixtures/leases.json",
        "cam": "fixtures/cam-2025.json",
        "gl": "fixtures/gl-2025.csv",
        "billed": "fixtures/cam-billed-2025.csv",
        "tenant": "L-102"
      },
      "expect": {
        "status": "executed",
        "contains": [
          "Nothing was sent"
        ]
      }
    },
    {
      "id": "review-mode-drafts-nothing",
      "tool": "cam_draft_statement",
      "mode": "review",
      "args": {
        "leases": "fixtures/leases.json",
        "cam": "fixtures/cam-2025.json",
        "gl": "fixtures/gl-2025.csv",
        "billed": "fixtures/cam-billed-2025.csv",
        "tenant": "L-102"
      },
      "expect": {
        "status": "blocked"
      }
    },
    {
      "id": "gl-lines-from-other-years-left-out",
      "tool": "cam_check",
      "args": {
        "leases": "fixtures/leases.json",
        "cam": "fixtures/cam-2025.json",
        "gl": "fixtures/gl-2025-with-other-years.csv",
        "billed": "fixtures/cam-billed-2025.csv"
      },
      "expect": {
        "status": "executed",
        "contains": [
          "gl_outside_year",
          "2 GL line(s) dated outside 2025 (24000) were left out"
        ],
        "equals": {
          "result.pools_total": 433000
        }
      }
    },
    {
      "id": "missing-file-named",
      "tool": "cam_check",
      "args": {
        "leases": "fixtures/leases.json",
        "cam": "fixtures/cam-2025.json",
        "gl": "fixtures/missing-export.csv",
        "billed": "fixtures/cam-billed-2025.csv"
      },
      "expect": {
        "status": "error",
        "contains": [
          "not found",
          "missing-export.csv"
        ]
      }
    }
  ]
}
